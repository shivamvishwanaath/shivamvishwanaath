shivamvishwanaath.dev {
    # Reverse proxy to local Next.js standalone process / container
    reverse_proxy 127.0.0.1:3000

    # Modern Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Compression
    encode gzip zstd

    # Static assets caching
    @static path /images/* /_next/static/* /favicon.ico /favicon-32x32.png /apple-touch-icon.png /site.webmanifest
    header @static Cache-Control "public, max-age=31536000, immutable"
}

# Redirect www to non-www canonical domain
www.shivamvishwanaath.dev {
    redir https://shivamvishwanaath.dev{uri} permanent
}
